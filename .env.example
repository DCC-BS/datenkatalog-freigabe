# Nuxt layer implementations, resolved at build time (Docker: pass as --build-arg).
AUTH_LAYER_URI=github:DCC-BS/nuxt-layers/azure-auth
LOGGER_LAYER_URI=github:DCC-BS/nuxt-layers/pino-logger

# Website login for app users (Entra app registration of this website).
NUXT_AZURE_AUTH_TENANT_ID=
NUXT_AZURE_AUTH_CLIENT_ID=
NUXT_AZURE_AUTH_CLIENT_SECRET=
# Leave empty: only needed for a separate backend API, which this app does not have.
NUXT_AZURE_AUTH_API_CLIENT_ID=
# Session encryption secret, at least 32 characters (e.g. openssl rand -base64 32).
NUXT_AZURE_AUTH_SECRET=
# <app URL>/api/auth, e.g. https://freigabe.datenkatalog.bs.ch/api/auth in production.
NUXT_AZURE_AUTH_ORIGIN=http://localhost:3000/api/auth

# Dataspot service-to-service (M2M) access for the server routes.
# This is NOT the login for app users (see NUXT_AZURE_AUTH_* above).
# Same variable names as dataspot_auth.py in the other repos.
DATASPOT_TENANT_ID=
DATASPOT_CLIENT_ID=
DATASPOT_CLIENT_SECRET=
DATASPOT_EXPOSED_CLIENT_ID=
DATASPOT_SERVICE_USER_ACCESS_KEY=
